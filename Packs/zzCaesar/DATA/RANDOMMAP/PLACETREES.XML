<placeobjects>
	<!-- Notes:
		- Greece inherits settings from Gaul, Britain from Rome, Egypt from Carthage, Germany from Iberia, so there is no way to customize them (they are hardcoded)
		- the names used here are the values of the properties "group" and "subgroup" of each tree section in the file "MapObjects/decors/decors.ini" -->
	<ifdef id="trees">
		<TreeRace race="Gaul">
			<TreeGroup name="Trees" weight="100">
				<TreeSubGrp name="Broad-leaved" weight="20" />
				<TreeSubGrp name="Pine trees" weight="65" />
				<TreeSubGrp name="Dead trees" weight="15" />
			</TreeGroup>
			<TreeGroup name="Bushes" weight="50">
				<TreeSubGrp name="Green bushes" weight="80" />
				<TreeSubGrp name="Dead bushes" weight="20" />
			</TreeGroup>
		</TreeRace>
		<TreeRace race="RepublicanRome">
			<TreeGroup name="Trees" weight="100">
				<TreeSubGrp name="Broad-leaved" weight="40" />
				<TreeSubGrp name="Pine trees" weight="40" />
				<TreeSubGrp name="Dead trees" weight="20" />
			</TreeGroup>
			<TreeGroup name="Bushes" weight="50">
				<TreeSubGrp name="Green bushes" weight="70" />
				<TreeSubGrp name="Dead bushes" weight="30" />
			</TreeGroup>
		</TreeRace>
		<TreeRace race="Carthage">
			<TreeGroup name="Trees" weight="100">
				<TreeSubGrp name="Dead trees" weight="25" />
				<TreeSubGrp name="Palms" weight="75" />
			</TreeGroup>
			<TreeGroup name="Bushes" weight="50">
				<TreeSubGrp name="Dead bushes" weight="35" />
				<TreeSubGrp name="Desert bushes" weight="65" />
			</TreeGroup>
		</TreeRace>
		<TreeRace race="Iberia">
			<TreeGroup name="Trees" weight="100">
				<TreeSubGrp name="Broad-leaved" weight="65" />
				<TreeSubGrp name="Pine trees" weight="15" />
				<TreeSubGrp name="Dead trees" weight="20" />
			</TreeGroup>
			<TreeGroup name="Bushes" weight="50">
				<TreeSubGrp name="Green bushes" weight="75" />
				<TreeSubGrp name="Dead bushes" weight="25" />
			</TreeGroup>
		</TreeRace>
		<TreeRace race="ImperialRome" /><!-- Greece -->
		<TreeRace race="Britain" />
		<TreeRace race="Egypt" />
		<TreeRace race="Germany" />
		<new-perlin id="trees" first-minor-oct="2" oct-count="3" persistence="0.3" cell-bits="6" />
			<PlaceTrees perlin-id="trees" thres="0.15" dens="0.10" inf-max="29" r1="3" r2="10" />
		<del-perlin id="trees" />
	</ifdef>
</placeobjects>