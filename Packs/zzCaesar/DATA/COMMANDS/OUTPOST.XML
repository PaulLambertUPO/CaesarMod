<commands>
	<cmd name="outpost_attack" priority="1"
		method="attack"
		button="Actions/Attack Arrows.bmp"
		key="a"
		rollover="Attack"
		cursor="attack">
		<cmdtext target="Unit" text="Click to attack this enemy" default-text="Right-click to attack this enemy" />
		<src obj="Outpost" />
		<nsrc obj="GGuardPost" />
	</cmd>
	<cmd name="outpost_advance" priority="2"
		button="Actions/Advance.bmp"
		key="e"
		groupdispatch="data/subai/outpost_advance.vs"
		rollover="Launch sortie"
		description="Orders units inside the building to advance towards the specified position">
		<cmdtext target="" text="Click to make all units advance to this position" />
		<src obj="Outpost" />
	</cmd>
	<cmd name="goutpost_sellfood" priority="4"
		button="states/sell food.bmp"
		immediate="yes"
		method="goutpost_sellfood"
		param="yes"
		groupverifier="data/subai/group_goutpost_sell_food_verify.vs"
		key="s"
		rollover="Sell food"
		description="Slowly exchanges stored food for gold">
		<src obj="GOutpost" />
		<src obj="TOutpost" />
	</cmd>
	<cmd name="goutpost_no_sellfood" priority="4"
		button="states/Stop Selling Food.bmp"
		immediate="yes"
		method="goutpost_sellfood"
		param="no"
		groupverifier="data/subai/group_goutpost_no_sell_food_verify.vs"
		key="s"
		rollover="Stop selling food">
		<src obj="GOutpost" />
		<src obj="TOutpost" />
	</cmd>
	<cmd name="goutpost_sellgold" priority="5"
		button="states/sell gold.bmp"
		immediate="yes"
		method="goutpost_sellgold"
		param="yes"
		groupverifier="data/subai/group_goutpost_sell_gold_verify.vs"
		key="l"
		rollover="Sell gold"
		description="Slowly exchanges stored gold for food">
		<src obj="GOutpost" />
		<src obj="TOutpost" />
	</cmd>
	<cmd name="goutpost_no_sellgold" priority="5"
		button="states/Stop Selling gold.bmp"
		immediate="yes"
		method="goutpost_sellgold"
		param="no"
		groupverifier="data/subai/group_goutpost_no_sell_gold_verify.vs"
		key="l"
		rollover="Stop selling gold">
		<src obj="GOutpost" />
		<src obj="TOutpost" />
	</cmd>
</commands>