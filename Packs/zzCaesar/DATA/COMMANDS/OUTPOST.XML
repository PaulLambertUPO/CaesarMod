<commands>
	<cmd name="outpost_attack" priority="1"
		method="attack"
		button="Actions/Attack Arrows.bmp"
		key="a"
		rollover="Attack"
		cursor="attack">
		<cmdtext target="Unit" text="Click to attack this enemy" default-text="Right-click to attack this enemy" />
		<src obj="Outpost" />
		<nsrc obj="GGuardPost" />
	</cmd>
	<cmd name="outpost_advance" priority="2"
		button="Actions/Advance.bmp"
		key="e"
		groupdispatch="data/subai/outpost_advance.vs"
		rollover="Launch sortie">
		<cmdtext target="" text="Click to make all units advance to this position" />
		<src obj="Outpost" />
	</cmd>
</commands>