<commands>
	<!-- DEFAULT COMMANDS (NO INTERFACE BUTTON AND ONLY USED BY CLASSES WITH THE CORRESPONDING METHOD) -->
	<cmd name="follow" cursor="do_something">
		<cmdtext target="Unit" default-text="Right-click to follow this unit" />
	</cmd>
	<cmd name="unload" cursor="do_something">
		<cmdtext target="Building" default-text="Right-click to unload the resources in this settlement" />
	</cmd>
	<!-- INTERFACE COMMANDS (WITH BUTTON) -->
	<cmd name="loadfood1" priority="3"
		method="loadfoodsmall"
		button="actions/load food small.bmp"
		key="d"
		rollover="Load 250 food">
		<src obj="Wagon" />
	</cmd>
	<cmd name="loadgold1" priority="4"
		method="loadgoldsmall"
		button="actions/load gold small.bmp"
		key="h"
		rollover="Load 250 gold">
		<src obj="Wagon" />
	</cmd>
	<cmd name="loadfood2" priority="5"
		method="loadfoodbig"
		button="Actions/load food.bmp"
		key="f"
		rollover="Load 1000 food">
		<src obj="Wagon" />
	</cmd>
	<cmd name="loadgold2" priority="6"
		method="loadgoldbig"
		button="actions/load gold.bmp"
		key="g"
		rollover="Load 1000 gold">
		<src obj="Wagon" />
	</cmd>
</commands>