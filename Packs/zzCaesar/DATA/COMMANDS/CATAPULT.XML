<commands>
	<!-- DEFAULT COMMANDS (NO INTERFACE BUTTON AND ONLY USED BY CLASSES WITH THE CORRESPONDING METHOD) -->
	<cmd name="catapult_attack" method="attack" cursor="attack" traincommand="yes">
		<cmdtext target="Building" default-text="Right-click to attack this building" />
		<cmdtext target="Unit" default-text="Right-click to attack this enemy" />
	</cmd>
	<cmd name="attack_ground" cursor="attack" traincommand="yes">
		<cmdtext target="" default-text="Right-click to attack this point" />
	</cmd>
	<!-- INTERFACE COMMANDS (WITH BUTTON) -->
	<cmd name="autofire"
		priority="1"
		button="actions/Catapult Attack.bmp"
		key="a"
		rollover="Fire at will"
		traincommand="yes"
		cursor="attack">
		<src obj="GCatapult" />
		<src obj="RCatapult" />
		<src obj="ICatapult" />
		<src obj="CCatapult" />
		<src obj="ECatapult" />
	</cmd>
	<cmd name="stop"
		priority="2"
		button="actions/stand ground.bmp"
		key="s"
		rollover="Stop firing"
		traincommand="yes">
		<src obj="GCatapult" />
		<src obj="RCatapult" />
		<src obj="ICatapult" />
		<src obj="CCatapult" />
		<src obj="ECatapult" />
	</cmd>
	<cmd name="disband"
		priority="3"
		button="actions/Desert Catapult.bmp"
		key="d"
		rollover="Dismantle"
		traincommand="yes">
		<src obj="Catapult" />
	</cmd>
</commands>