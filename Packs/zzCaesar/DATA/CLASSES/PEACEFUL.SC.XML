<class id="Peaceful" parent="Unit" cpp_class="CVXUnit">

	<properties damage="0" damage_type="none" />
	<properties range="17" min_range="2" />
	<properties radius="15" selection_radius="15" />
	<properties formation_priority="100" />
	<properties formation_radius="26" />
	<properties target_factor="1000" />

	<method sig="idle" vs="data/subai/peaceful_idle.vs" />
	<method sig="attack" vs="data/subai/unit_approach.vs" />
	<method sig="attack" vs="data/subai/unit_move.vs" />
	<method sig="engage" vs="data/subai/do_nothing_void.vs" />
