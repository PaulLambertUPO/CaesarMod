	<method sig="advance" vs="data/subai/unit_move.vs" />
	<method sig="advance_aggressive" vs="data/subai/unit_move.vs" />
	<method sig="advanceenter" vs="data/subai/peaceful_enter.vs" />
	<method sig="enter" vs="data/subai/peaceful_enter.vs" verify="data/subai/peaceful_enter_verify.vs" />
	<method sig="enteralone" vs="data/subai/peaceful_enter.vs" verify="data/subai/peaceful_enter_verify.vs" />
