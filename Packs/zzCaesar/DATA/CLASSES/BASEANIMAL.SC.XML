<class id="BaseAnimal" parent="Unit" cpp_class="CVXUnit">

	<properties damage="0" />
	<properties damage_type="none" />
	<properties damaged_by_ghost="0" />
	<properties feeds="0" max_food="0" />
	<properties repair_rate="0" />
	<properties always_visible_on_minimap="1" />
	<properties healthbaroffset="-30" />

	<properties unit_specials="Freedom" />

	<properties help="contents/units/Animals" />

	<method sig="form_move" vs="data/subai/unit_detach.vs" />
	<method sig="attach" vs="data/subai/do_nothing_obj.vs" verify="data/subai/do_nothing_verify.vs" />
	<method sig="capture" vs="data/subai/do_nothing_obj.vs" verify="data/subai/do_nothing_verify.vs" />
	<method sig="enter" vs="data/subai/peaceful_enter.vs" verify="data/subai/peaceful_enter_verify.vs" />
	<method sig="enter_alone" vs="data/subai/peaceful_enter.vs" />
	<method sig="build_catapult" vs="data/subai/do_nothing_obj.vs" />

	<defaultcmd target="Building">
		<cmd name="enter" />
	</defaultcmd>
	<defaultcmd target="Teleport">
		<cmd name="teleport" />
	</defaultcmd>
	<defaultcmd target="Inn">
		<cmd name="transport" />
	</defaultcmd>
</class>