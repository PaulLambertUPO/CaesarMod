<class id="Animal" parent="BaseAnimal" cpp_class="CVXUnit">
	<!-- this class is actually PeacefulAnimal -->

	<properties target_factor="-1" />

	<method sig="idle" vs="data/subai/peaceful_idle.vs" />
	<method sig="advance" vs="data/subai/unit_move.vs" />
	<method sig="advancealone" vs="data/subai/unit_move.vs" />
	<method sig="advance_aggressive" vs="data/subai/unit_move.vs" />
	<method sig="attack" vs="data/subai/unit_approach.vs" verify="data/subai/do_nothing_verify.vs" />
	<method sig="engage" vs="data/subai/do_nothing_void.vs" />
	<method sig="advanceenter" vs="data/subai/peaceful_enter.vs" />
	<method sig="stand_position" vs="data/subai/unit_standstill.vs" />
	<method sig="hold_position" vs="data/subai/unit_standstill.vs" />
	<method sig="ai_attack_gate" vs="data/subai/unit_approach.vs" />
	<method sig="ai_killall" vs="data/subai/do_nothing_void.vs" />
	<method sig="attack_unit_type_exclusive" vs="data/subai/unit_approach.vs" verify="data/subai/do_nothing_verify.vs" />
	<method sig="engage_unit_type_exclusive" vs="data/subai/do_nothing_void.vs" />

	<value1 icon="gameres/infobar/common/attack ico.bmp"
		script="return Translate('No');"
		help="contents/stats/attack"
		rollover="Damage"
	/>

	<defaultcmd target="ShipBattle">
		<cmd name="boardship" />
	</defaultcmd>
</class>