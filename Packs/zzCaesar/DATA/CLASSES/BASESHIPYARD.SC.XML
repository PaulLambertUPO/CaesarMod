<class id="BaseShipyard" parent="Building" cpp_class="CVXTownHall" entity="Buildings/GShipyard1/GShipyard1_as.ent.xml" entity_winter="Buildings/GShipyard1/GShipyard1_w.ent.xml">
	<!-- the entity value is necessary otherwise the game crashes with random maps -->
	<properties maxhealth="5000" sight="900" />
	<properties auto_repair="yes" repair_rate="250" />
	<properties interface="thumb,building,queue" />
	<properties minimap_icon_type="color" />
	<properties display_name="Shipyard" />
	<properties help="contents/buildings/Shipyard" />
	<properties
		is_central_building="1"
		can_be_captured="1"
		can_be_attacked="1"
		produces_gold="0"
		produces_food="0"
		is_single_building="1"
		settlement_food="0"
		settlement_gold="0"
		settlement_maxfood="10000"
		settlement_maxgold="10000"
		population="0"
		efficiency="0"
		max_population="0"
		max_units="0"
	/>

	<behavior script="data/subai/shipyard_supply_and_fishermen.vs" />

	<method sig="tribute" vs="data/subai/do_nothing_point.vs" />
	<method sig="tribute" vs="data/subai/village_tributefood.vs" verify="data/subai/village_tributefood_verify.vs" />
	<method sig="tribute_default" vs="data/subai/village_tributefood.vs" verify="data/subai/village_tributefood_verify.vs" />
	<method sig="stoptribute" vs="data/subai/village_stoptribute.vs" />
	<method sig="createfoodmulesmall" vs="data/subai/do_nothing_void.vs" />
	<method sig="createfoodmulebig" vs="data/subai/do_nothing_void.vs" />
	<method sig="creategoldmulesmall" vs="data/subai/do_nothing_void.vs" />
	<method sig="creategoldmulebig" vs="data/subai/do_nothing_void.vs" />
	<method sig="createfoodboatsmall" vs="data/subai/do_nothing_void.vs" />
	<method sig="createfoodboatbig" vs="data/subai/do_nothing_void.vs" />
	<method sig="creategoldboatsmall" vs="data/subai/do_nothing_void.vs" />
	<method sig="creategoldboatbig" vs="data/subai/do_nothing_void.vs" />
	<method sig="build_ship" vs="data/subai/shipyard_build_ship.vs" />
	<method sig="deploy_fishermen" vs="data/subai/shipyard_deploy_fishermen.vs" />

	<value0 icon="gameres/infobar/common/Fisherman.bmp"
		script="return EnvReadInt(.AsBuilding().settlement, 'Fishermen') + '/50';"
		help="contents/resources"
		rollover="Fishermen"
	/>
	<value1 icon="gameres/infobar/common/gold ico.bmp"
		script="return .AsBuilding().settlement.gold;"
		help="contents/resources"
		rollover="Gold"
	/>
	<value2 icon="gameres/infobar/common/fish.bmp"
		script="return .AsBuilding().settlement.food;"
		help="contents/resources"
		rollover="Fish"
	/>
	<value3 icon="gameres/infobar/common/Loyality.bmp"
		script="return .AsBuilding().settlement.loyalty;"
		help="contents/capturing"
		rollover="Loyalty"
	/>
	<value4 icon="gameres/infobar/common/health ico.bmp"
		script="return .health + '/' + .maxhealth;"
		help="contents/stats/health"
		rollover="Health"
	/>

	<defaultcmd target="BaseTownhall">
		<cmd name="tribute_default" />
	</defaultcmd>
	<defaultcmd target="BaseVillage">
		<cmd name="tribute_default" />
	</defaultcmd>
	<defaultcmd target="Outpost">
		<cmd name="tribute_default" />
	</defaultcmd>
	<defaultcmd target="BaseShipyard">
		<cmd name="tribute_default" />
	</defaultcmd>
</class>