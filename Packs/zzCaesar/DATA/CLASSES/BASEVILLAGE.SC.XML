<class id="BaseVillage" parent="BaseBuilding" cpp_class="CVXTownHall">
	<properties
		is_central_building="1"
		can_be_captured="1"
		can_be_attacked="1"
		produces_gold="0"
		produces_food="1"
		is_single_building="0"
		settlement_food="100"
		settlement_gold="0"
		settlement_maxfood="5000"
		settlement_maxgold="5000"
		population="12"
		efficiency="1"
		max_population="20"
		max_units="0"
	/>
	<properties house_pop_bonus="10" />
	<properties radius="230" selection_radius="250" />
	<properties interface="thumb,building,queue" />
	<properties auto_repair="yes" repair_rate="250" />
	<properties minimap_icon_type="color" />
	<properties display_name="Village Hall" />
	<properties help="contents/buildings/Village"/>

	<behavior script="data/subai/village_supply_and_give_food.vs" />
	<behavior script="data/subai/settlement_behavior_ambient.vs" />
	<behavior script="data/subai/settlement_behavior_upgrades.vs" />
	<behavior script="data/subai/settlement_sentries_control.vs" />

	<method sig="repopulate" vs="data/subai/village_repopulate.vs" />
	<method sig="tribute" vs="data/subai/village_tributefood.vs" verify="data/subai/village_tributefood_verify.vs" />
	<method sig="tribute" vs="data/subai/do_nothing_point.vs" />
	<method sig="stoptribute" vs="data/subai/village_stoptribute.vs" />
	<method sig="createfoodmulesmall" vs="data/subai/do_nothing_void.vs" />
	<method sig="createfoodmulebig" vs="data/subai/do_nothing_void.vs" />
	<method sig="creategoldmulesmall" vs="data/subai/do_nothing_void.vs" />
	<method sig="creategoldmulebig" vs="data/subai/do_nothing_void.vs" />
	<method sig="autotrainpeasant" vs="data/subai/village_autotrainpeasant.vs" />
	<method sig="trainpeasant" vs="data/subai/village_trainpeasant.vs" />
	<method sig="trainfisherman" vs="data/subai/village_trainfisherman.vs" />

	<defaultcmd target="BaseTownhall">
		<cmd name="tribute_default" />
	</defaultcmd>
	<defaultcmd target="BaseVillage">
		<cmd name="tribute_default" />
	</defaultcmd>
	<defaultcmd target="BaseShipyard">
		<cmd name="tribute_default" />
	</defaultcmd>
	<defaultcmd target="Outpost">
		<cmd name="tribute_default" />
	</defaultcmd>
	<defaultcmd target="GGuardPost">
		<cmd name="tribute_default" />
	</defaultcmd>
	<defaultcmd target="TTent">
		<cmd name="tribute_default" />
	</defaultcmd>
	<defaultcmd target="CTent">
		<cmd name="tribute_default" />
	</defaultcmd>

	<sounds select="VillageSelect" />
</class>