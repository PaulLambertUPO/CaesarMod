<class id="GGhostUnit" parent="Unit" cpp_class="CVXGhost" entity="Units/GGhost/GGhost.ent.xml">

	<properties race="Gaul" />
	<properties maxhealth="600" />
	<properties damage="1" damage_type="none" />
	<properties armor_slash="4" armor_pierce="4" />
	<properties range="250" />
	<properties speed="60" />
	<properties unit_specials="Freedom" />
	<properties feeds="0" max_food="0" />

	<properties damaged_by_ghost="0" />
	<properties repair_rate="0" />
	<properties target_factor="200" />
	<properties healthbar_type="2" />
	<properties healthbaroffset="-65" />

	<properties does_not_regenerate="1" />
	<properties stamina_dec_time="1000" />

	<properties select_class="GGhostUnit" />

	<properties display_name="Ghoul" display_name_plural="Ghouls" />
	<properties icon="gameres/icons/Ghost.bmp" />
	<properties help="contents/units/Ghost" />
	<properties edittree_pos="Units/Others/Ghoul" />

	<method sig="spawn" vs="data/subai/ghost_spawn.vs" />

	<method sig="idle" vs="data/subai/ghost_idle.vs" />
	<method sig="move" vs="data/subai/ghost_move.vs" />
	<method sig="advance" vs="data/subai/ghost_move.vs" />
	<method sig="advance_alone" vs="data/subai/ghost_move.vs" />
	<method sig="advance_aggressive" vs="data/subai/ghost_move.vs" />
	<method sig="attack" vs="data/subai/ghost_attack.vs" verify="data/subai/do_nothing_verify.vs" />
	<method sig="attack_unit_type_exclusive" vs="data/subai/ghost_attack.vs" verify="data/subai/do_nothing_verify.vs" />
	<method sig="ai_attack_gate" vs="data/subai/ghost_attack.vs" />
	
	<method sig="enter" vs="data/subai/peaceful_enter.vs" verify="data/subai/peaceful_enter_verify.vs" />
	<method sig="enter_alone" vs="data/subai/peaceful_enter.vs" />
	<method sig="advance_enter" vs="data/subai/peaceful_enter.vs" />
	<method sig="stand_position" vs="data/subai/unit_standstill.vs" />
	<method sig="hold_position" vs="data/subai/unit_standstill.vs" />

	<method sig="form_move" vs="data/subai/unit_detach.vs" />
	<method sig="attach" vs="data/subai/do_nothing_obj.vs" verify="data/subai/do_nothing_verify.vs" />
	<method sig="capture" vs="data/subai/do_nothing_obj.vs" verify="data/subai/do_nothing_verify.vs" />
	<method sig="engage" vs="data/subai/do_nothing_void.vs" />
	<method sig="engage_unit_type_exclusive" vs="data/subai/do_nothing_void.vs" />
	<method sig="build_catapult" vs="data/subai/do_nothing_obj.vs" />
	<method sig="ai_killall" vs="data/subai/do_nothing_void.vs" />

	<value1 icon="gameres/infobar/common/attack ico.bmp"
		script="return Translate('No') + '|' + .AsUnit().range;"
		help="contents/stats/attack"
		rollover="Damage|Range"
	/>

	<defaultcmd target="ShipBattle">
		<cmd name="boardship" />
	</defaultcmd>
	<defaultcmd target="Building">
		<cmd name="enter" />
	</defaultcmd>
	<defaultcmd target="Teleport">
		<cmd name="teleport" />
	</defaultcmd>
	<defaultcmd target="Inn">
		<cmd name="transport" />
	</defaultcmd>

	<sounds die="GhostDie" />
</class>