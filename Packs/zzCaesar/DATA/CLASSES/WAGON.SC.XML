<class id="Wagon" parent="Peaceful" cpp_class="CVXWagon">

	<properties maxhealth="400" />
	<properties speed="80" />
	<properties max_load="1000" />
	<properties inventory_size="0" />
	<properties feeds="0" />
	<properties healthbar_type="1" />

	<method sig="unload" vs="data/subai/wagon_unload.vs" verify="data/subai/wagon_unload_verify.vs" />
	<method sig="loadgoldbig" vs="data/subai/wagon_loadgoldbig.vs" />
	<method sig="loadfoodbig" vs="data/subai/wagon_loadfoodbig.vs" />
	<method sig="loadgoldsmall" vs="data/subai/wagon_loadgoldsmall.vs" />
	<method sig="loadfoodsmall" vs="data/subai/wagon_loadfoodsmall.vs" />

	<method sig="form_move" vs="data/subai/unit_detach.vs" />
	<method sig="attach" vs="data/subai/do_nothing_obj.vs" verify="data/subai/do_nothing_verify.vs" />

	<value0 icon="gameres/infobar/common/Loyality.bmp"
		script="return .AsWagon().loyalty;"
		help="contents/capturing"
		rollover="Loyalty"
	/>

	<nodefcmdinherit />

	<defaultcmd target="">
		<cmd name="move" />
	</defaultcmd>
	<defaultcmd target="Object">
		<cmd name="approach" />
	</defaultcmd>
</class>