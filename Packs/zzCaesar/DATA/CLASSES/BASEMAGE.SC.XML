<class id="BaseMage" parent="Peaceful" cpp_class="CVXDruid">

	<properties damage="1" armor_slash="2" armor_pierce="2" />
	<properties range="200" min_range="0" sight="400" />

	<properties target_factor="100" />
	<properties healthbar_type="2" />

	<method sig="train" vs="data/subai/do_nothing_void.vs" />
	<method sig="learn" vs="data/subai/druid_learn.vs" verify="data/subai/druid_learn_verify.vs" />
	<method sig="learn" vs="data/subai/druid_learn_ground.vs" />

	<value1 icon="gameres/infobar/common/attack ico.bmp"
		script="return Translate('No') + '|' + .AsUnit().range;"
		help="contents/stats/attack"
		rollover="Damage|Range"
	/>

	<defaultcmd target="Unit">
		<cmd name="learn" />
	</defaultcmd>

	<sounds walk="UnarmoredUnitWalk" />
</class>